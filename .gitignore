# Secrets and credentials — never commit
*.env
*.env.*
.env
.env.*
secrets.json
secrets.*.json
*.pem
*.key
*.pfx
*.p12
credentials.json
.netrc
.npmrc
auth.json
token.json
tokens.json
cookies.txt
*-cookies.txt

# Local backups created by installer/uninstall tooling (machine-specific)
backups/
*.bak
*.backup
*.orig
*.rej

# Installer logs and local diagnostic output
logs/
*.log
diagnostics/
*.diagnostics.json

# Machine-specific / generated local state
state/
.install-state.json
.env.local
*.local.json

# Throwaway upstream clones used for source review during discovery/research
.research/

# Local state written by agent desktop apps into the working directory
.freebuff/
.cline/
.opencode/

# Editor / OS noise
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store

# Generated video and media from local renders. Nothing rendered should ever be committed.
# A rendered MP4 can be hundreds of megabytes and is reproducible from its source project.
*.mp4
*.webm
*.mov
*.mkv
*.gif
renders/
.smoke-test/

# Node
node_modules/
.cache/
.temp/
tmp/
dist/
build/
coverage/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
